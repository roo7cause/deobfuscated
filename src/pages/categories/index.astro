---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getUniqueCategories from "@/utils/getUniqueCategories";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const categories = getUniqueCategories(posts);

const categoryDescriptions: Record<string, string> = {
  "Intrusion Log": "True incident stories from DFIR experiences",
  "Frameworks": "Frameworks and models for cybersecurity strategies",
  "Research": "POC research, news, and exploratory work",
  "Diary": "Personal anecdotes and real-life experiences",
};
---

<Layout title={`Categories | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Categories" pageDesc="Browse articles by category.">
    <ul class="flex flex-col gap-6">
      {categories.map(({ category, categoryName }) => (
        <li>
          <a
            href={`/categories/${category}/`}
            class="block border-b-2 border-dashed border-foreground pb-2 hover:border-accent hover:text-accent transition-colors"
          >
            <h2 class="text-xl font-semibold mb-1" style="font-family: var(--font-heading);">{categoryName}</h2>
            <p class="text-sm opacity-75">
              {categoryDescriptions[categoryName] || ""}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </Main>
  <Footer />
</Layout>
