---
import IconX from "@/assets/icons/IconX.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  // Exact match
  if (currentPath === path) return true;
  
  // For category paths, check if we're on that category page
  if (path.startsWith("/categories/")) {
    const categorySlug = pathArray[pathArray.length - 1] || pathArray[pathArray.length - 2];
    return currentPathArray.includes("categories") && 
           (currentPathArray[currentPathArray.length - 1] === categorySlug || 
            currentPathArray[currentPathArray.length - 2] === categorySlug);
  }
  
  return currentPathArray[0] === pathArray[0];
};

const categories = [
  { name: "Intrusion Log", slug: slugifyStr("Intrusion Log") },
  { name: "Frameworks", slug: slugifyStr("Frameworks") },
  { name: "Research", slug: slugifyStr("Research") },
  { name: "Diary", slug: slugifyStr("Diary") },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header class="app-layout">
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 sm:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex flex-col",
    ]}
  >
    <div class="mb-4 sm:mb-6">
      <a href="/" class="inline-block">
        <img
          src="/deobfuscated-title-image-3.png"
          alt={SITE.title}
          class="bg-transparent border-0"
        />
      </a>
    </div>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:flex-row sm:justify-center sm:space-x-6 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "mt-4 flex flex-col items-center gap-2",
          "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:text-accent [&>li>a]:hover:text-foreground sm:[&>li>a]:px-2 sm:[&>li>a]:py-1 sm:[&>li>a]:whitespace-nowrap",
          "hidden sm:!flex",
          "sm:mt-0 sm:flex-row sm:w-auto sm:gap-x-8 sm:gap-y-0",
        ]}
      >
        {categories.map(({ name, slug }) => (
          <li>
            <a
              href={`/categories/${slug}/`}
              class:list={{
                "active-nav": isActive(`/categories/${slug}/`),
              }}
              style="font-family: var(--font-heading);"
            >
              {name}
            </a>
          </li>
        ))}
        <li>
          <a 
            href="/about" 
            class:list={{ "active-nav": isActive("/about") }}
            style="font-family: var(--font-heading);"
          >
            About
          </a>
        </li>
        <li class="flex items-center justify-center">
          <LinkButton
            href="/search"
            class:list={[
              "focus-outline flex p-3 sm:p-1",
              { "[&>svg]:stroke-accent": isActive("/search") },
            ]}
            title="Search"
            aria-label="search"
          >
            <IconSearch />
            <span class="sr-only">Search</span>
          </LinkButton>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      // Only toggle on mobile (when menu button is visible)
      if (window.innerWidth < 640) {
        menuItems.classList.toggle("hidden");
      }
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
